  "item": [
    {"name":"01 - Raiz","request":{"method":"GET","header":[],"url":"{{baseUrl}}/"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Retorna status HTTP 200\", function () {","  pm.response.to.have.status(200);","});"]}}]},
    {"name":"02 - Resumo","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Retorna status HTTP 200\", function () {","  pm.response.to.have.status(200);","});"]}}]},
    {"name":"03 - Health","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/health"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Retorna status HTTP 200\", function () {","  pm.response.to.have.status(200);","});","pm.test(\"API responde status ok\", function () {","  const json = pm.response.json();","  pm.expect(json.success).to.eql(true);","  pm.expect(json.status).to.eql(\"ok\");","});"]}}]},
    {"name":"04 - Listar","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/leituras?page=1&limit=5"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Retorna status HTTP 200\", function () {","  pm.response.to.have.status(200);","});","pm.test(\"Listagem tem data e meta\", function () {","  const json = pm.response.json();","  pm.expect(json.data).to.be.an(\"array\");","  pm.expect(json.meta).to.have.property(\"total\");","  pm.expect(json.meta.page).to.eql(1);","  pm.expect(json.meta.limit).to.eql(5);","});"]}}]},
    {"name":"05 - Filtrar estação","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/leituras?station_id=EM-ARACATUBA-01"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Retorna status HTTP 200\", function () {","  pm.response.to.have.status(200);","});"]}}]},
    {"name":"06 - Filtrar período","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/leituras?data_inicio=2026-01-01&data_fim=2026-01-03"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Retorna status HTTP 200\", function () {","  pm.response.to.have.status(200);","});"]}}]},
    {"name":"07 - Criar","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"station_id\": \"EM-POSTMAN-01\",\n  \"timestamp\": \"2026-11-11T08:00:00-03:00\",\n  \"temperature_c\": 25.5,\n  \"humidity_pct\": 62.3\n}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/api/leituras"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"POST criou uma leitura\", function () {","  pm.response.to.have.status(201);","  const json = pm.response.json();","  pm.expect(json.success).to.eql(true);","  pm.expect(json.data.id).to.be.a(\"number\");","});","const novoId = pm.response.json().data.id;","pm.environment.set(\"id_leitura\", novoId);"]}}]},
    {"name":"08 - Buscar por ID","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/leituras/{{id_leitura}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"GET localizou o ID criado\", function () {","  pm.response.to.have.status(200);","  const json = pm.response.json();","  pm.expect(json.data.id).to.eql(Number(pm.environment.get(\"id_leitura\")));","});"]}}]},
    {"name":"09 - Atualizar","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"station_id\": \"EM-POSTMAN-01\",\n  \"timestamp\": \"2026-11-11T09:00:00-03:00\",\n  \"temperature_c\": 26.8,\n  \"humidity_pct\": 60.1\n}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/api/leituras/{{id_leitura}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Retorna status HTTP 200\", function () {","  pm.response.to.have.status(200);","});"]}}]},
    {"name":"10 - Excluir por ID","request":{"method":"DELETE","header":[],"url":"{{baseUrl}}/api/leituras/{{id_leitura}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Retorna status HTTP 200\", function () {","  pm.response.to.have.status(200);","});"]}}]},
    {"name":"11 - Listar após exclusão","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/leituras?page=1&limit=5"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Retorna status HTTP 200\", function () {","  pm.response.to.have.status(200);","});"]}}]},
    {"name":"12 - Erro 404","request":{"method":"GET","header":[],"url":"{{baseUrl}}/api/leituras/999999"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"ID inexistente retorna 404\", function () {","  pm.response.to.have.status(404);","  pm.expect(pm.response.json().success).to.eql(false);","});"]}}]},
    {"name":"13 - Erro 400","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"station_id\": \"EM-POSTMAN-ERRO\",\n  \"timestamp\": \"2026-11-11T09:00:00-03:00\",\n  \"temperature_c\": 26.8,\n  \"humidity_pct\": 120\n}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/api/leituras"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"Umidade inválida retorna 400\", function () {","  pm.response.to.have.status(400);","  pm.expect(pm.response.json().success).to.eql(false);","});"]}}]},
